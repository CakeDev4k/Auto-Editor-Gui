{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PrimeTrim",
  "version": "../package.json",
  "identifier": "com.threshold.primetrim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PrimeTrim",
        "width": 760,
        "height": 820,
        "minWidth": 640,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/auto_editor",
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/ffplay"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFNUM4QUFFMkM3RUFCMjMKUldRanEzNHNyb3BjbnJtVFdldVRoYzltbGR5TCt5cHBHdkNxbDRENUFOV0g4ZTdLN0JlMW1mL3MK",
      "endpoints": [
        "https://github.com/CakeDev4k/Auto-Editor-Gui/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
